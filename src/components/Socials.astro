---
import { SOCIALS } from "@config";
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
---

<div class:list={["social-icons", centered && "centered"]}>
  {
    SOCIALS.filter(social => social.active).map(social => (
      <LinkButton
        href={social.href}
        className="icon-control"
        title={social.linkTitle}
        openInNewTab={social.openInNewTab}
      >
        <Fragment set:html={socialIcons[social.name]} />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<style>
  @reference "#base.css";
  /* Always flex: it used to gain `flex` only via the `centered` prop, so on the
     home page (no prop) this was a block and flex-wrap/gap/justify-center
     silently did nothing — the icons were spaced by raw inline-block
     whitespace. `centered` now only picks the alignment. */
  .social-icons {
    @apply flex flex-wrap items-center gap-1;
  }
  .social-icons.centered {
    @apply justify-center;
  }
</style>
