---
import { useTranslations } from "@i18n/ui";
import { getLocaleFromPath } from "@i18n/utils";
import LinkButton from "./LinkButton.astro";
import socialIcons from "@assets/socialIcons";

const URL = Astro.url;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const shareLinks = [
  {
    name: "WhatsApp",
    href: "https://wa.me/?text=",
    via: true,
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/sharer.php?u=",
    via: false,
  },
  {
    name: "X",
    href: "https://x.com/intent/post?url=",
    via: false,
  },
  {
    name: "Mail",
    href: "mailto:?subject=See%20this%20post&body=",
    via: true,
    wordKey: "post.shareMail",
  },
] as const;

// The label used to be a hardcoded English string, so on /es/ pages the
// `title` and the sr-only text announced "Share this post via WhatsApp" to
// screen readers regardless of locale.
// `wordKey` covers the one network whose spoken name is a common noun rather
// than a brand: "Compartir por Mail" reads wrong, "Compartir por correo" is
// right. The icon is still looked up by `name`.
const shareLabel = (social: (typeof shareLinks)[number]) =>
  `${t(social.via ? "post.shareVia" : "post.shareOn")} ${
    "wordKey" in social ? t(social.wordKey) : social.name
  }`;
---

<div class="share-links">
  <span class="share-label">{t("post.share")}</span>
  <div class="share-row">
    {
      shareLinks.map(social => {
        const label = shareLabel(social);
        return (
          <LinkButton
            href={`${social.href + URL}`}
            className="icon-control"
            title={label}
          >
            <Fragment set:html={socialIcons[social.name]} />
            <span class="sr-only">{label}</span>
          </LinkButton>
        );
      })
    }
  </div>
</div>

<style>
  @reference "#base.css";
  .share-links {
    /* w-full only on mobile: in the sm+ row it shares the line with
       `Back to Top`, and a 100%-width card would squeeze that button. */
    @apply flex w-full flex-col items-center gap-1.5 rounded-lg border border-skin-line/70 bg-skin-card/65 px-3 py-2.5 sm:w-auto sm:items-start;
  }
  .share-label {
    @apply font-mono text-xs tracking-wide text-skin-base/70;
  }
  /* The row is flex from this component (its own element, so the scoped rule
     matches). `icon-control` on the anchors is a global utility for the same
     reason: LinkButton's <a> cannot carry our scope id. */
  .share-row {
    @apply flex flex-wrap items-center justify-center gap-1 sm:justify-start;
  }
</style>
