---
import {
  SUPPORTED_LOCALES,
  getLocaleFromPath,
  localizePath,
  LOCALE_INFO,
} from "@i18n/utils";

export interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Language" } = Astro.props;
const currentLocale = getLocaleFromPath(Astro.url.pathname);
---

<!-- iOS-style menu: one compact trigger, popover anchored to it -->
<div class="locale-switcher">
  <button
    type="button"
    class="locale-trigger focus-outline"
    aria-label={ariaLabel}
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm7.931 9h-3.028a15.9 15.9 0 0 0-1.129-4.893A8.02 8.02 0 0 1 19.931 11zM12 4.047c1.191 1.371 2.062 3.527 2.243 5.953H9.757c.181-2.426 1.052-4.582 2.243-5.953zM4.069 11H7.097a15.9 15.9 0 0 1 1.129-4.893A8.02 8.02 0 0 0 4.069 11zm0 2a8.02 8.02 0 0 0 4.157 4.893A15.9 15.9 0 0 1 7.097 13H4.069zm7.931 6.953c-1.191-1.371-2.062-3.527-2.243-5.953h4.486c-.181 2.426-1.052 4.582-2.243 5.953zm3.703-2.06A15.9 15.9 0 0 0 16.903 13h3.028a8.02 8.02 0 0 1-4.157 4.893z"
      ></path>
    </svg>
    <span class="locale-code">{LOCALE_INFO[currentLocale].code}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="locale-chevron"
      viewBox="0 0 24 24"
      aria-hidden="true"
      ><path d="M12 15.5 5.5 9l1.4-1.4L12 12.7l5.1-5.1L18.5 9z"></path>
    </svg>
  </button>

  <div class="locale-menu" role="menu" aria-label={ariaLabel}>
    {
      SUPPORTED_LOCALES.map(locale => {
        const isActive = currentLocale === locale;
        return (
          <a
            href={localizePath(Astro.url.pathname, locale)}
            role="menuitem"
            aria-checked={isActive ? "true" : "false"}
            lang={LOCALE_INFO[locale].langTag}
            class:list={["locale-item", isActive && "locale-item-active"]}
          >
            <span>{LOCALE_INFO[locale].name}</span>
            {isActive && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="locale-check"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M9 19.2 3.8 14l-1.4 1.4L9 22 21.6 9.4 20.2 8z" />
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</div>

<style>
  @reference "#base.css";
  .locale-switcher {
    @apply relative flex items-center;
  }

  .locale-trigger {
    @apply inline-flex h-11 items-center justify-center gap-1.5 rounded-md border border-transparent px-2.5 py-2 text-sm font-semibold no-underline opacity-85 transition-all duration-150 hover:border-skin-line/80 hover:bg-skin-card/70 hover:text-skin-accent hover:opacity-100 active:scale-95 sm:h-8 sm:px-2 sm:text-xs;
  }
  .locale-trigger svg {
    @apply h-4 w-4;
  }
  .locale-trigger:hover svg {
    @apply fill-skin-accent;
  }
  .locale-trigger .locale-chevron {
    @apply fill-skin-base/60 transition-transform duration-150;
  }
  .locale-trigger[aria-expanded="true"] .locale-chevron {
    @apply rotate-180;
  }

  /* Popover originates from the trigger — spatial consistency */
  .locale-menu {
    @apply absolute right-0 top-full z-50 mt-2 w-44 origin-top-right rounded-lg border border-skin-line/70 bg-skin-card/95 p-1 shadow-card backdrop-blur-md;
    visibility: hidden;
    opacity: 0;
    transform: scale(0.95) translateY(-2px);
    pointer-events: none;
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out,
      visibility 0s linear 150ms;
  }
  .locale-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .locale-menu {
      transform: none;
    }
  }

  .locale-item {
    @apply flex items-center justify-between gap-3 rounded-md px-3 py-2 font-mono text-sm no-underline transition-all duration-150 hover:bg-skin-fill/75 hover:text-skin-accent active:scale-[0.97];
  }
  .locale-check {
    @apply h-4 w-4;
  }
  .locale-item-active {
    @apply text-skin-accent;
  }
  .locale-item-active svg {
    @apply fill-skin-accent;
  }
</style>

<script>
  function initLanguageMenu() {
    const switcher = document.querySelector(".locale-switcher");
    const trigger = switcher?.querySelector<HTMLElement>(".locale-trigger");
    const menu = switcher?.querySelector<HTMLElement>(".locale-menu");

    if (!switcher || !trigger || !menu || switcher.dataset.bound === "true") {
      return;
    }
    switcher.dataset.bound = "true";

    const isOpen = () => trigger.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean, restoreFocus = false) => {
      trigger.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("is-open", open);
      if (open) {
        // Screen readers land on the current language first
        menu.querySelector<HTMLElement>('[aria-checked="true"]')?.focus();
      } else if (restoreFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener("click", () => {
      setOpen(!isOpen());
    });

    // Close when tapping/clicking anywhere outside the switcher
    document.addEventListener("pointerdown", event => {
      if (isOpen() && !switcher.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", event => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.stopPropagation();
        setOpen(false, true);
      }
    });

    // Arrow-key navigation, like native menus
    menu.addEventListener("keydown", event => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      const items = Array.from(
        menu.querySelectorAll<HTMLElement>(".locale-item")
      );
      if (items.length === 0) return;
      const index = items.indexOf(document.activeElement as HTMLElement);
      const next =
        event.key === "ArrowDown"
          ? (index + 1) % items.length
          : (index - 1 + items.length) % items.length;
      items[next].focus();
    });

    // Close cleanly before navigating away
    menu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        trigger.setAttribute("aria-expanded", "false");
        menu.classList.remove("is-open");
      });
    });
  }

  initLanguageMenu();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", initLanguageMenu);
</script>
