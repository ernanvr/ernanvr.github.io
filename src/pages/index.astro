---
import Index from "@layouts/Index.astro";
import { getSortedPostsByLocale } from "@utils/posts";

const locale = "en";
const sortedPosts = await getSortedPostsByLocale(locale);
---

<Index
  locale={locale}
  heroTitle="Hi, I'm Ernán."
  heroBody="I'm obsessed with understanding and using AI to solve problems of productivity, time and cost. On this site I share my path exploring that passion, and also a more personal side. Success without purpose is empty."
  sortedPosts={sortedPosts}
/>
