---
import Index from "@layouts/Index.astro";
import { getSortedPostsByLocale } from "@utils/posts";

const locale = "es";
const sortedPosts = await getSortedPostsByLocale(locale);
---

<Index
  locale={locale}
  heroTitle="Hola, soy Ernán."
  heroBody="Tengo una obsesión por entender y utilizar la IA para resolver problemas de productividad, tiempo y costos. En este sitio comparto mi camino para explorar esa pasión, pero también un lado más personal. El éxito sin propósito es vacío."
  sortedPosts={sortedPosts}
/>
