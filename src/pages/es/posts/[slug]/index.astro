---
import type { CollectionEntry } from "astro:content";
import PostDetails from "@layouts/PostDetails.astro";
import { getSortedPostsByLocale } from "@utils/posts";
import { getPostDetailsStaticPaths } from "@utils/staticPaths";

export interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  return getPostDetailsStaticPaths("es");
}

// Full list (incl. archived) so prev/next navigation works on archived posts too
const sortedPosts = await getSortedPostsByLocale("es", {
  includeArchived: true,
});
---

<PostDetails post={Astro.props.post} posts={sortedPosts} locale="es" />
